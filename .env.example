# ── Vector DB backend ─────────────────────────────────
VECTORDB_BACKEND=qdrant
# Change to "pinecone" and fill Pinecone section to switch backends

# ── Qdrant local ──────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ── Qdrant Cloud (replace above when using cloud) ─────
# QDRANT_URL=https://your-cluster.qdrant.io:6333
# QDRANT_API_KEY=your-cloud-api-key

QDRANT_COLLECTION=company_knowledge
QDRANT_VECTOR_SIZE=768

# ── Pinecone (fill when VECTORDB_BACKEND=pinecone) ────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=

# Optional: serverless index creation (Pinecone) — defaults shown
PINECONE_CLOUD=aws

# ── Master DB ─────────────────────────────────────────
MASTER_DB_URL=sqlite:///./data/master.db

# ── Master API ────────────────────────────────────────
ADMIN_API_KEY=
APP_HOST=0.0.0.0
APP_PORT=9000

# ── Container calls ───────────────────────────────────
CONTAINER_CALL_TIMEOUT=10.0
CONTAINER_HEALTH_TIMEOUT=3.0

# ── Embedding ─────────────────────────────────────────
EMBEDDING_BACKEND=ollama

# Ollama (default)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_VECTOR_SIZE=768

# OpenAI (set EMBEDDING_BACKEND=openai and fill these)
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small
# EMBEDDING_VECTOR_SIZE=1536

# ── Ingestion ─────────────────────────────────────────
INGESTION_INTERVAL_MINUTES=60
INGESTION_COLLECTION=company_knowledge

# ── Conversation fact-extraction ──────────────────────
# Set these ONCE on the master; every provisioned context inherits them.
# Off by default — turn on to extract durable facts from conversations into the KB.
CONVERSATION_EXTRACTION_ENABLED=false
# Provider: "gemini" (Gemini Flash) or "anthropic" (Claude Haiku)
EXTRACTION_BACKEND=gemini
# Gemini (from Google AI Studio). WARNING: the FREE tier may train on submitted
# data — link a billing account before routing customer conversations through it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Anthropic alternative (used only when EXTRACTION_BACKEND=anthropic)
# EXTRACTION_ANTHROPIC_API_KEY=sk-ant-...
# EXTRACTION_MODEL=claude-haiku-4-5

# ── Security ──────────────────────────────────────────
CREDENTIAL_ENCRYPTION_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
