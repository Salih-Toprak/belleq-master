# ── Vector DB backend ─────────────────────────────────
VECTORDB_BACKEND=qdrant
# Change to "pinecone" and fill Pinecone section to switch backends

# ── Qdrant local ──────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ── Qdrant Cloud (replace above when using cloud) ─────
# QDRANT_URL=https://your-cluster.qdrant.io:6333
# QDRANT_API_KEY=your-cloud-api-key

QDRANT_COLLECTION=company_knowledge
QDRANT_VECTOR_SIZE=768

# ── Pinecone (fill when VECTORDB_BACKEND=pinecone) ────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=

# Optional: serverless index creation (Pinecone) — defaults shown
PINECONE_CLOUD=aws

# ── Master DB ─────────────────────────────────────────
MASTER_DB_URL=sqlite:///./data/master.db

# ── Master API ────────────────────────────────────────
ADMIN_API_KEY=
APP_HOST=0.0.0.0
APP_PORT=9000

# ── Container calls ───────────────────────────────────
CONTAINER_CALL_TIMEOUT=10.0
CONTAINER_HEALTH_TIMEOUT=3.0
